generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceType {
  PERSONAL
  ORGANIZATION
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ContactType {
  PERSON
  COMPANY
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

enum CategoryDirection {
  EXPENSE
  INCOME
  BOTH
}

enum FinancialDirection {
  PAYABLE
  RECEIVABLE
}

enum FinancialKind {
  ONE_TIME
  INSTALLMENT_PLAN
  RECURRING
}

enum FinancialStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELED
}

enum InstallmentStatus {
  SCHEDULED
  PARTIAL
  SETTLED
  OVERDUE
  CANCELED
}

enum IntegrationProvider {
  MERCADO_PAGO
  EVOLUTION_API
}

enum TransactionSource {
  MERCADO_PAGO_API
  CSV_IMPORT
  MANUAL_ADJUSTMENT
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum FinanceMode {
  MANUAL
  HYBRID
}

enum FinancialAccountType {
  MANUAL
  MERCADO_PAGO
}

enum ReconciliationStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  IGNORED
  REVERSED
}

enum MatchedBy {
  SYSTEM
  USER
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  name          String
  image         String?
  timezone      String       @default("America/Sao_Paulo")
  locale        String       @default("pt-BR")
  status        String       @default("ACTIVE")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  workspaces    Workspace[]  @relation("WorkspaceOwner")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

model SyncRun {
  id                   String            @id @default(uuid())
  workspaceId          String            @map("workspace_id")
  integrationAccountId String?           @map("integration_account_id")
  source               TransactionSource @default(MERCADO_PAGO_API)
  status               String            @default("PENDING")
  beginDate            DateTime          @map("begin_date")
  endDate              DateTime          @map("end_date")
  remoteReportId       String?           @map("remote_report_id")
  remoteTaskId         String?           @map("remote_task_id")
  remoteFileName       String?           @map("remote_file_name")
  startedAt            DateTime?         @map("started_at")
  finishedAt           DateTime?         @map("finished_at")
  insertedCount        Int               @default(0) @map("inserted_count")
  updatedCount         Int               @default(0) @map("updated_count")
  skippedCount         Int               @default(0) @map("skipped_count")
  errorCode            String?           @map("error_code")
  errorMessage         String?           @map("error_message")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integrationAccount IntegrationAccount? @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)

  @@map("sync_runs")
}

model BalanceSyncRun {
  id                   String    @id @default(uuid())
  workspaceId          String    @map("workspace_id")
  integrationAccountId String    @map("integration_account_id")
  financialAccountId   String    @map("financial_account_id")
  status               String    @default("PENDING")
  beginDate            DateTime  @map("begin_date")
  endDate              DateTime  @map("end_date")
  remoteTaskId         String?   @map("remote_task_id")
  remoteReportId       String?   @map("remote_report_id")
  remoteFileName       String?   @map("remote_file_name")
  activeKey            String?   @unique @map("active_key")
  balanceCents         BigInt?   @map("balance_cents")
  requestedAt          DateTime? @map("requested_at")
  finishedAt           DateTime? @map("finished_at")
  errorCode            String?   @map("error_code")
  errorMessage         String?   @map("error_message")
  evidenceSummary      Json?     @map("evidence_summary")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integrationAccount IntegrationAccount @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)
  financialAccount   FinancialAccount   @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@unique([integrationAccountId, beginDate, endDate])
  @@map("balance_sync_runs")
}

model Workspace {
  id                   String                @id @default(uuid())
  name                 String
  type                 WorkspaceType         @default(PERSONAL)
  ownerUserId          String                @map("owner_user_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  financeMode          FinanceMode           @default(MANUAL) @map("finance_mode")
  owner                User                  @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  memberships          Membership[]
  contacts             Contact[]
  categories           Category[]
  financialItems       FinancialItem[]
  recurrenceRules      RecurrenceRule[]
  integrationAccounts  IntegrationAccount[]
  externalTransactions ExternalTransaction[]
  pixCharges           PixCharge[]
  reconciliations      Reconciliation[]
  ledgerEntries        LedgerEntry[]
  notificationRules    NotificationRule[]
  attachments          Attachment[]
  auditLogs            AuditLog[]
  syncRuns             SyncRun[]
  balanceSyncRuns      BalanceSyncRun[]
  paymentIntentions    PaymentIntention[]
  categoryRules        CategoryRule[]
  whatsAppLogs         WhatsAppDeliveryLog[]
  notificationEvents   NotificationEvent[]
  financialAccounts    FinancialAccount[]

  @@map("workspaces")
}

model FinancialAccount {
  id                    String                @id @default(uuid())
  workspaceId           String                @map("workspace_id")
  type                  FinancialAccountType
  name                  String
  openingBalanceCents   BigInt?               @map("opening_balance_cents")
  openingBalanceAt      DateTime?             @map("opening_balance_at")
  officialBalanceCents  BigInt?               @map("official_balance_cents")
  officialBalanceAt     DateTime?             @map("official_balance_at")
  officialBalanceStatus String                @default("UNAVAILABLE") @map("official_balance_status")
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integrationAccount    IntegrationAccount?
  externalTransactions  ExternalTransaction[]
  ledgerEntries         LedgerEntry[]
  balanceSyncRuns       BalanceSyncRun[]

  @@unique([workspaceId, type])
  @@map("financial_accounts")
}

model Membership {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  userId      String         @map("user_id")
  role        MembershipRole @default(OWNER)
  createdAt   DateTime       @default(now()) @map("created_at")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("memberships")
}

model Contact {
  id             String          @id @default(uuid())
  workspaceId    String          @map("workspace_id")
  name           String
  type           ContactType     @default(PERSON)
  document       String?
  email          String?
  phone          String?
  merchantCity   String?         @map("merchant_city")
  isDebtor       Boolean         @default(false) @map("is_debtor")
  isPayee        Boolean         @default(false) @map("is_payee")
  notes          String?
  archivedAt     DateTime?       @map("archived_at")
  deletedAt      DateTime?       @map("deleted_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pixKeys        PixKey[]
  financialItems FinancialItem[]

  @@map("contacts")
}

model PixKey {
  id           String        @id @default(uuid())
  contactId    String        @map("contact_id")
  type         PixKeyType
  value        String
  label        String?
  isDefault    Boolean       @default(false) @map("is_default")
  verifiedAt   DateTime?     @map("verified_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@map("pix_keys")
}

model Category {
  id             String            @id @default(uuid())
  workspaceId    String            @map("workspace_id")
  name           String
  direction      CategoryDirection @default(BOTH)
  icon           String?
  colorToken     String?           @map("color_token")
  parentId       String?           @map("parent_id")
  isSystem       Boolean           @default(false) @map("is_system")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent         Category?         @relation("CategoryParent", fields: [parentId], references: [id])
  children       Category[]        @relation("CategoryParent")
  financialItems FinancialItem[]
  ledgerEntries  LedgerEntry[]
  categoryRules  CategoryRule[]

  @@map("categories")
}

model FinancialItem {
  id                    String             @id @default(uuid())
  workspaceId           String             @map("workspace_id")
  direction             FinancialDirection
  kind                  FinancialKind
  title                 String
  description           String?
  contactId             String?            @map("contact_id")
  categoryId            String?            @map("category_id")
  totalAmountCents      BigInt             @map("total_amount_cents")
  startDate             DateTime           @map("start_date")
  status                FinancialStatus    @default(ACTIVE)
  recurrenceRuleId      String?            @map("recurrence_rule_id")
  scheduledOccurrenceAt DateTime?          @map("scheduled_occurrence_at")
  source                String             @default("USER")
  deletedAt             DateTime?          @map("deleted_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact               Contact?           @relation(fields: [contactId], references: [id])
  category              Category?          @relation(fields: [categoryId], references: [id])
  recurrenceRule        RecurrenceRule?    @relation(fields: [recurrenceRuleId], references: [id])
  installments          Installment[]
  reconciliations       Reconciliation[]
  pixCharges            PixCharge[]
  paymentIntentions     PaymentIntention[]

  @@unique([recurrenceRuleId, scheduledOccurrenceAt])
  @@map("financial_items")
}

model Installment {
  id                 String                @id @default(uuid())
  financialItemId    String                @map("financial_item_id")
  sequence           Int
  amountCents        BigInt                @map("amount_cents")
  dueDate            DateTime              @map("due_date")
  settledAmountCents BigInt                @default(0) @map("settled_amount_cents")
  status             InstallmentStatus     @default(SCHEDULED)
  selectedPixKeyId   String?               @map("selected_pix_key_id")
  settlementDate     DateTime?             @map("settlement_date")
  uniqueReference    String?               @unique @map("unique_reference")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  financialItem      FinancialItem         @relation(fields: [financialItemId], references: [id], onDelete: Cascade)
  selectedPixKey     PixKey?               @relation(fields: [selectedPixKeyId], references: [id])
  reconciliations    Reconciliation[]
  pixCharges         PixCharge[]
  ledgerEntries      LedgerEntry[]
  paymentIntentions  PaymentIntention[]
  whatsAppLogs       WhatsAppDeliveryLog[]

  @@map("installments")
}

model RecurrenceRule {
  id             String          @id @default(uuid())
  workspaceId    String          @map("workspace_id")
  frequency      String
  interval       Int             @default(1)
  dayOfMonth     Int?            @map("day_of_month")
  startsAt       DateTime        @map("starts_at")
  endsAt         DateTime?       @map("ends_at")
  nextRunAt      DateTime?       @map("next_run_at")
  timezone       String          @default("America/Sao_Paulo")
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialItems FinancialItem[]

  @@map("recurrence_rules")
}

model IntegrationAccount {
  id                       String                @id @default(uuid())
  workspaceId              String                @map("workspace_id")
  provider                 IntegrationProvider   @default(MERCADO_PAGO)
  environment              String                @default("SANDBOX")
  externalAccountId        String?               @map("external_account_id")
  externalApplicationId    String?               @map("external_application_id")
  displayName              String                @map("display_name")
  encryptedCredentials     String?               @map("encrypted_credentials")
  credentialKeyVersion     Int                   @default(1) @map("credential_key_version")
  capabilities             Json?
  status                   String                @default("DISCONNECTED")
  isActive                 Boolean               @default(true) @map("is_active")
  lastValidatedAt          DateTime?             @map("last_validated_at")
  lastValidationErrorCode  String?               @map("last_validation_error_code")
  lastSyncAt               DateTime?             @map("last_sync_at")
  firstImportedAt          DateTime?             @map("first_imported_at")
  coverageStart            DateTime?             @map("coverage_start")
  coverageEnd              DateTime?             @map("coverage_end")
  financialAccountId       String?               @unique @map("financial_account_id")
  providerAccountCreatedAt DateTime?             @map("provider_account_created_at")
  historyBackfillStatus    String                @default("NOT_STARTED") @map("history_backfill_status")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  workspace                Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalTransactions     ExternalTransaction[]
  pixCharges               PixCharge[]
  syncRuns                 SyncRun[]
  balanceSyncRuns          BalanceSyncRun[]
  financialAccount         FinancialAccount?     @relation(fields: [financialAccountId], references: [id])

  @@unique([workspaceId, provider, environment])
  @@map("integration_accounts")
}

model ExternalTransaction {
  id                   String               @id @default(uuid())
  workspaceId          String               @map("workspace_id")
  source               TransactionSource    @default(MERCADO_PAGO_API)
  integrationAccountId String?              @map("integration_account_id")
  financialAccountId   String?              @map("financial_account_id")
  provider             IntegrationProvider?
  externalId           String               @map("external_id")
  direction            TransactionDirection
  type                 String
  status               String
  amountCents          BigInt               @map("amount_cents")
  feeCents             BigInt               @default(0) @map("fee_cents")
  netAmountCents       BigInt               @map("net_amount_cents")
  occurredAt           DateTime             @map("occurred_at")
  counterpartName      String?              @map("counterpart_name")
  counterpartDocument  String?              @map("counterpart_document")
  txid                 String?
  description          String
  rawReference         String?              @map("raw_reference")
  rawProviderData      Json?                @map("raw_provider_data")
  rawEnrichmentData    Json?                @map("raw_enrichment_data")
  importedAt           DateTime             @default(now()) @map("imported_at")
  quarantinedAt        DateTime?            @map("quarantined_at")
  quarantineReason     String?              @map("quarantine_reason")
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integrationAccount   IntegrationAccount?  @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)
  financialAccount     FinancialAccount?    @relation(fields: [financialAccountId], references: [id])
  reconciliations      Reconciliation[]
  ledgerEntries        LedgerEntry[]

  @@unique([workspaceId, source, externalId])
  @@map("external_transactions")
}

model Reconciliation {
  id                    String               @id @default(uuid())
  workspaceId           String               @map("workspace_id")
  externalTransactionId String               @map("external_transaction_id")
  installmentId         String?              @map("installment_id")
  financialItemId       String?              @map("financial_item_id")
  status                ReconciliationStatus @default(UNMATCHED)
  score                 Int                  @default(0)
  reasons               Json?
  matchedBy             MatchedBy            @default(SYSTEM)
  matchedAt             DateTime?            @map("matched_at")
  reversedAt            DateTime?            @map("reversed_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  workspace             Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalTransaction   ExternalTransaction  @relation(fields: [externalTransactionId], references: [id], onDelete: Cascade)
  installment           Installment?         @relation(fields: [installmentId], references: [id])
  financialItem         FinancialItem?       @relation(fields: [financialItemId], references: [id])

  @@map("reconciliations")
}

model PixCharge {
  id                   String              @id @default(uuid())
  workspaceId          String              @map("workspace_id")
  integrationAccountId String              @map("integration_account_id")
  financialItemId      String              @map("financial_item_id")
  installmentId        String              @map("installment_id")
  provider             IntegrationProvider @default(MERCADO_PAGO)
  environment          String              @default("SANDBOX")
  externalOrderId      String?             @unique @map("external_order_id")
  externalPaymentId    String?             @map("external_payment_id")
  externalReference    String              @unique @map("external_reference")
  idempotencyKey       String              @unique @map("idempotency_key")
  amountCents          BigInt              @map("amount_cents")
  currency             String              @default("BRL")
  status               String              @default("CREATING") // CREATING, PENDING, ACTION_REQUIRED, PAID, EXPIRED, CANCELLED, FAILED, REFUNDED
  statusDetail         String?             @map("status_detail")
  qrCode               String?             @map("qr_code")
  ticketUrl            String?             @map("ticket_url")
  expiresAt            DateTime?           @map("expires_at")
  paidAt               DateTime?           @map("paid_at")
  lastCheckedAt        DateTime?           @map("last_checked_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integrationAccount IntegrationAccount    @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)
  financialItem      FinancialItem         @relation(fields: [financialItemId], references: [id], onDelete: Cascade)
  installment        Installment           @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  whatsAppLogs       WhatsAppDeliveryLog[]

  @@map("pix_charges")
}

model LedgerEntry {
  id                    String               @id @default(uuid())
  workspaceId           String               @map("workspace_id")
  externalTransactionId String?              @unique @map("external_transaction_id")
  installmentId         String?              @map("installment_id")
  financialAccountId    String?              @map("financial_account_id")
  reversesEntryId       String?              @unique @map("reverses_entry_id")
  direction             TransactionDirection
  amountCents           BigInt               @map("amount_cents")
  occurredAt            DateTime             @map("occurred_at")
  sourceType            String               @map("source_type")
  sourceId              String?              @map("source_id")
  categoryId            String?              @map("category_id")
  excludedFromReports   Boolean              @default(false) @map("excluded_from_reports")
  createdAt             DateTime             @default(now()) @map("created_at")
  workspace             Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalTransaction   ExternalTransaction? @relation(fields: [externalTransactionId], references: [id])
  installment           Installment?         @relation(fields: [installmentId], references: [id])
  financialAccount      FinancialAccount?    @relation(fields: [financialAccountId], references: [id])
  reversesEntry         LedgerEntry?         @relation("LedgerReversals", fields: [reversesEntryId], references: [id])
  reversedBy            LedgerEntry?         @relation("LedgerReversals")
  category              Category?            @relation(fields: [categoryId], references: [id])

  @@map("ledger_entries")
}

model NotificationRule {
  id               String    @id @default(uuid())
  workspaceId      String    @map("workspace_id")
  scope            String    @default("GLOBAL")
  financialItemId  String?   @map("financial_item_id")
  daysBefore       Int[]     @map("days_before")
  onDueDate        Boolean   @default(true) @map("on_due_date")
  overdueFrequency Int       @default(1) @map("overdue_frequency")
  hour             Int       @default(9)
  channels         String[]  @default(["DASHBOARD"])
  enabled          Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("notification_rules")
}

model Attachment {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  ownerType    String    @map("owner_type")
  ownerId      String    @map("owner_id")
  storageKey   String    @map("storage_key")
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  size         BigInt
  checksum     String?
  uploadedBy   String?   @map("uploaded_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  actorType   String    @map("actor_type")
  actorId     String    @map("actor_id")
  action      String
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model WebhookEvent {
  id             String    @id @default(uuid())
  provider       String    @default("MERCADO_PAGO")
  environment    String    @default("SANDBOX")
  eventId        String    @map("event_id")
  resourceType   String    @map("resource_type")
  resourceId     String    @map("resource_id")
  action         String?
  applicationId  String?   @map("application_id")
  liveMode       Boolean   @default(false) @map("live_mode")
  signatureValid Boolean   @default(false) @map("signature_valid")
  status         String    @default("RECEIVED") // RECEIVED, PROCESSED, FAILED
  attempts       Int       @default(1)
  receivedAt     DateTime  @default(now()) @map("received_at")
  processedAt    DateTime? @map("processed_at")
  lastErrorCode  String?   @map("last_error_code")
  payloadHash    String?   @map("payload_hash")

  @@unique([provider, environment, eventId])
  @@map("webhook_events")
}

model PaymentIntention {
  id                  String    @id @default(uuid())
  workspaceId         String    @map("workspace_id")
  financialItemId     String    @map("financial_item_id")
  installmentId       String    @map("installment_id")
  favoredName         String    @map("favored_name")
  favoredPixKey       String    @map("favored_pix_key")
  favoredPixKeyType   String    @map("favored_pix_key_type")
  expectedAmountCents BigInt    @map("expected_amount_cents")
  status              String    @default("WAITING") // WAITING, MATCHED, DIVERGENT, EXPIRED, CANCELED
  txid                String?
  brCodePayload       String?   @map("br_code_payload")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  financialItem FinancialItem @relation(fields: [financialItemId], references: [id], onDelete: Cascade)
  installment   Installment   @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@map("payment_intentions")
}

model CategoryRule {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  pattern         String
  categoryId      String   @map("category_id")
  confidenceScore Int      @default(80) @map("confidence_score")
  source          String   @default("USER") // USER, SYSTEM
  isEnabled       Boolean  @default(true) @map("is_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, pattern])
  @@map("category_rules")
}

model WhatsAppDeliveryLog {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  recipientPhone  String    @map("recipient_phone")
  chargeId        String?   @map("charge_id")
  installmentId   String?   @map("installment_id")
  messageType     String    @map("message_type")
  remoteMessageId String?   @map("remote_message_id")
  status          String    @default("SENT") // SENT, FAILED, DELIVERED
  attemptCount    Int       @default(1) @map("attempt_count")
  lastAttemptAt   DateTime  @default(now()) @map("last_attempt_at")
  nextRetryAt     DateTime? @map("next_retry_at")
  errorMessage    String?   @map("error_message")
  dedupeKey       String    @unique @map("dedupe_key")
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pixCharge   PixCharge?   @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@map("whatsapp_delivery_logs")
}

model NotificationEvent {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  type        String // PAYMENT_RECEIVED, DUPLICATE_WARNING, ACTION_REQUIRED, OVERDUE_WARNING, SYNC_FAILED
  title       String
  message     String
  dedupeKey   String?  @unique @map("dedupe_key")
  metadata    Json?
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("notification_events")
}
