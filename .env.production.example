# NOVEX Finance — exemplo de produção. Nunca versionar o arquivo .env.production real.
NODE_ENV=production
NOVEX_HTTP_PORT=3001
NOVEX_EVOLUTION_PORT=8081
NEXT_PUBLIC_APP_URL=https://www.app.novexfinance.com.br

POSTGRES_USER=novexfinance
POSTGRES_PASSWORD=GERAR_SENHA_EXCLUSIVA_FORTE
POSTGRES_DB=novexfinance

AUTH_SECRET=GERAR_SEGREDO_EXCLUSIVO_FORTE
WORKER_SECRET=GERAR_OUTRO_SEGREDO_EXCLUSIVO_FORTE
CREDENTIALS_ENCRYPTION_KEY_BASE64=GERAR_32_BYTES_EM_BASE64
MERCADO_PAGO_WEBHOOK_SECRET=CONFIGURAR_SEGREDO_REAL

EVOLUTION_API_KEY=GERAR_CHAVE_EXCLUSIVA_FORTE
EVOLUTION_INSTANCE_NAME=novex-finance

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
