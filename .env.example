# Ambiente
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo

# Banco de Dados
DATABASE_URL=postgresql://novex:novex_dev_password@postgres:5432/novex_finance

# Redis
REDIS_URL=redis://redis:6379

# Autenticação
AUTH_SECRET=novex_dev_secret_key_change_in_production_32chars
ALLOW_PUBLIC_SIGNUP=false

# Configurações de Seed Local (Dev)
DEV_SEED_EMAIL=frank@novexfinance.local
DEV_SEED_PASSWORD=sua_senha_dev_aqui

# Criptografia de credenciais de integrações
CREDENTIALS_ENCRYPTION_KEY=novex_dev_encryption_key_32chars_long

# Mercado Pago — NUNCA VERSIONAR VALORES REAIS
MERCADO_PAGO_ACCESS_TOKEN=REMOVIDO
MERCADO_PAGO_WEBHOOK_SECRET=REMOVIDO

# Storage local no desenvolvimento
UPLOADS_DIR=/app/uploads
