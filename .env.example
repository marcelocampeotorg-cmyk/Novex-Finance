# Ambiente
NODE_ENV=development
NOVEX_HTTP_PORT=3001
APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
APP_TIMEZONE=America/Sao_Paulo

# Banco de Dados
DATABASE_URL=postgresql://USUARIO:SENHA@postgres:5432/BANCO
POSTGRES_USER=USUARIO
POSTGRES_PASSWORD=SENHA_FORTE
POSTGRES_DB=BANCO

# Redis
REDIS_URL=redis://redis:6379

# Autenticação
AUTH_SECRET=GERAR_SEGREDO_FORTE
WORKER_SECRET=GERAR_SEGREDO_FORTE_DIFERENTE
ALLOW_PUBLIC_SIGNUP=false

# Configurações de Seed Local (Dev)
DEV_SEED_EMAIL=frank@novexfinance.local
DEV_SEED_PASSWORD=sua_senha_dev_aqui

# Criptografia de credenciais de integrações (Chave Base64 de exatamente 32 bytes decodificados)
CREDENTIALS_ENCRYPTION_KEY_BASE64=GERAR_32_BYTES_EM_BASE64

# Mercado Pago — NUNCA VERSIONAR VALORES REAIS
MERCADO_PAGO_ACCESS_TOKEN=REMOVIDO
MERCADO_PAGO_WEBHOOK_SECRET=REMOVIDO
EVOLUTION_API_KEY=GERAR_CHAVE_FORTE
EVOLUTION_API_URL=http://127.0.0.1:8081
EVOLUTION_PUBLIC_URL=http://localhost:8081
EVOLUTION_INSTANCE_NAME=novex-finance
PIX_MERCHANT_CITY=CIDADE_REAL_DO_FAVORECIDO

# Storage local no desenvolvimento
UPLOADS_DIR=/app/uploads
